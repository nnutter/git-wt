#!/usr/bin/env bash

set -uo pipefail

PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin"
PATH="$PATH:$HOME/.local/bin:$HOME/.local/share/mise/shims"
PATH="$PATH:/home/linuxbrew/.linuxbrew/bin"
export PATH

readonly git_wt_command="git-wt"
readonly fzf_command="fzf"

show_error() {
    local message="$1"

    printf '\nError: %s\n' "$message" >&2
    printf 'Press Enter to close. ' >&2
    IFS= read -r _discarded_input || true
}

require_command() {
    local command_name="$1"

    if command -v "$command_name" >/dev/null 2>&1; then
        return 0
    fi

    show_error "Required command not found: $command_name"
    return 1
}

get_repository_names() {
    local repository_names

    if ! repository_names=$("$git_wt_command" repo list --quiet); then
        show_error 'Could not list git-wt repositories.'
        return 1
    fi
    if [[ -z "$repository_names" ]]; then
        show_error 'No git-wt repositories are registered.'
        return 1
    fi

    printf '%s\n' "$repository_names"
}

select_repository() {
    local repository_names="$1"

    printf '%s\n' "$repository_names" | "$fzf_command" \
        --no-multi \
        --layout=reverse \
        --border=rounded \
        --prompt='Repository > ' \
        --header='Type to filter. Enter selects. Esc cancels.'
}

prompt_for_worktree_name() {
    local worktree_name

    while true; do
        printf 'Worktree name: ' >&2
        IFS= read -r worktree_name || return 1
        if [[ -n "$worktree_name" ]]; then
            printf '%s\n' "$worktree_name"
            return 0
        fi
        printf 'The worktree name must not be empty.\n' >&2
    done
}

create_worktree() {
    local repository_name="$1"
    local worktree_name="$2"

    printf '\nCreating %s in %s...\n\n' "$worktree_name" "$repository_name"
    "$git_wt_command" create --repo "$repository_name" "$worktree_name"
}

main() {
    local repository_names
    local repository_name
    local worktree_name

    require_command "$git_wt_command" || return 1
    require_command "$fzf_command" || return 1

    repository_names=$(get_repository_names) || return 1
    repository_name=$(select_repository "$repository_names") || return 0
    worktree_name=$(prompt_for_worktree_name) || return 0

    if ! create_worktree "$repository_name" "$worktree_name"; then
        show_error 'git-wt could not create the worktree.'
        return 1
    fi
}

main "$@"
